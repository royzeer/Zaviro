    "prettier": "^3.9.10",
    "tailwindcss": "3.4",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "5.4",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "2.1"
