# Copia este archivo como .env y completa tus valores. Nunca subas el .env a GitHub.

PORT=4000
NODE_ENV=development
# Direcciones desde las que se puede usar la API, separadas por comas
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zaviro
# En la nube (por ejemplo Aiven): DB_SSL=true y, si lo tienes, el certificado CA en DB_CA_CERT
DB_SSL=false
DB_CA_CERT=

# Seguridad (usa una frase larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=30d

# Inteligencia artificial (opcional). Sin clave la app organiza los apuntes con su modo propio.
# La clave se crea en https://platform.claude.com (API Keys). Claude cobra por uso.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Documentos que cada cuenta puede analizar con IA por hora
IA_LIMITE_POR_HORA=15
